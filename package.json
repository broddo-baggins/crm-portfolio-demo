{
  "name": "crm-portfolio-demo",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_DEMO_MODE=true vite",
    "build": "VITE_DEMO_MODE=true vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:desktop": "playwright test -c e2e/playwright.config.ts --project=desktop",
    "test:e2e:mobile": "playwright test -c e2e/playwright.config.ts --project=mobile",
    "knip": "knip --include files,dependencies,unlisted,binaries,unresolved",
    "security-check": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run type-check && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
